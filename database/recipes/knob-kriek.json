    { "name": "lemon juice", "quantity": 0.75, "unit": "fl oz" },
    { "name": "maraschino liqueur", "quantity": 0.5, "unit": "fl oz", "is_spirit": true },
    { "name": "brandied cherry", "quantity": 1, "unit": "count", "note": "garnish" }
  ],
  "steps": [
    "Add the bourbon, lemon juice, and maraschino liqueur to a cocktail shaker. Shake over ice.",
