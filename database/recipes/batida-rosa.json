{
  "title": "Batida rosa",
  "portions": 1,
  "season": "summer",
  "ingredients": [
    { "name": "grenadine syrup", "quantity": 0.75, "unit": "fl oz" },
    { "name": "pineapple gum syrup", "quantity": 0.5, "unit": "fl oz" },
    { "name": "pisco", "quantity": 2, "unit": "fl oz", "is_spirit": true },
    { "name": "lemon juice", "quantity": 0.75, "unit": "fl oz" },
    { "name": "club soda", "quantity": 3, "unit": "fl oz" },
    { "name": "orange twist", "quantity": 1, "unit": "count", "note": "garnish" }
  ],
  "steps": [
    "Add all ingredients except the club soda and orange twist to a shaker with ice. Shake for 5 seconds.",
    "Strain into a chilled glass and top with the club soda.",
    "Garnish with the orange twist."
  ]
}
