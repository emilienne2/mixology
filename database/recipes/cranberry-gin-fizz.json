    { "name": "ginger beer", "quantity": 5, "unit": "fl oz" },
    { "name": "gin", "quantity": 7.5, "unit": "fl oz", "is_spirit": true },
    { "name": "candied cranberries", "note": "with the ginger beer" },
    { "name": "mint sprig", "note": "garnish", "optional": true }
